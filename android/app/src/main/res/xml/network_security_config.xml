<?xml version="1.0" encoding="utf-8"?>
<!--
  GaGa Chat — network security policy.
  Cleartext (HTTP) traffic is disabled globally. Only HTTPS endpoints are
  reachable, which is required for Play Store compliance and user safety.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
