<?xml version="1.0" encoding="utf-8"?>
<!--
  GaGa adaptive-icon background.
  Brand: deep charcoal (#0B0B0F) base with a subtle GaGa-green (#00C300) radial
  glow, replacing the default Android Studio teal grid template.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportHeight="108"
    android:viewportWidth="108">
    <!-- Solid brand base -->
    <path
        android:fillColor="#0B0B0F"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Soft green radial glow behind the logo mark -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="62"
                android:type="radial">
                <item
                    android:color="#3300C300"
                    android:offset="0.0" />
                <item
                    android:color="#1400C300"
                    android:offset="0.55" />
                <item
                    android:color="#0000C300"
                    android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
