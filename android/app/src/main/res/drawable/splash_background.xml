    <item android:drawable="@color/line_green" />
    <item
        android:width="132dp"
        android:height="132dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill"
            android:src="@drawable/gaga_logo_master" />
    </item>
</layer-list>
