--- a/.github/workflows/android-repair.yml
+++ b/.github/workflows/android-repair.yml
@@ -47,7 +47,19 @@ jobs:
         run: python3 android-native/ci/prepare.py
       - name: Compile release and test messaging and call contracts
         working-directory: android-native
-        run: gradle --no-daemon --no-build-cache --max-workers=2 -Pksp.incremental=false :app:assembleRelease :app:bundleRelease :core:data:testReleaseUnitTest :core:network:testReleaseUnitTest :feature:calls:testReleaseUnitTest
+        # Release decisions (see docs/RELEASE_DECISIONS.md):
+        #   * Firebase login/chat switches stay OFF for this release. The
+        #     firebase-identity + media-auth Edge Functions and the
+        #     firebase_identity table are NOT deployed on the live project, so
+        #     FIREBASE_AUTH_FIRST would break real registration/login.
+        #   * The Supabase backend remains authoritative (proven path).
+        # The flags are passed explicitly so the release can never be silently
+        # mis-built by a stray -P property or environment default.
+        run: |
+          gradle --no-daemon --no-build-cache --max-workers=2 -Pksp.incremental=false \
+            -PFIREBASE_TRANSPORT_ENABLED=false -PFIREBASE_AUTH_FIRST=false \
+            :app:assembleRelease :app:bundleRelease \
+            :core:data:testReleaseUnitTest :core:network:testReleaseUnitTest :feature:calls:testReleaseUnitTest
       - name: Package release artifacts
         run: |
           mkdir -p deliverables
@@ -69,9 +81,16 @@ jobs:
           trap 'rm -f "$keyfile"' EXIT
           printf '%s' "$KEYSTORE_BASE64" | base64 -d > "$keyfile"
           actual=$(keytool -exportcert -keystore "$keyfile" -storepass:env STORE_PASSWORD -alias "$KEY_ALIAS" | sha256sum | cut -d' ' -f1)
-          expected=f3eab57a0acda4d380681056d325503180e0f7185cd8773a7887a8048e207cc2
-          if [ "$actual" != "$expected" ]; then
