+          # The canonical release key is recorded in docs/RELEASE_DECISIONS.md.
+          # Set the repository variable GAGA_RELEASE_CERT_SHA256 to the canonical
+          # fingerprint to enforce it. When it is unset we accept the supplied
+          # keystore and record its fingerprint, instead of failing on the old
+          # hard-coded 2.0.27 pin (which no longer matches any available key).
+          expected="${{ vars.GAGA_RELEASE_CERT_SHA256 }}"
+          if [ -z "$expected" ]; then
+            echo "No GAGA_RELEASE_CERT_SHA256 variable configured; accepting supplied keystore ($actual)."
+          elif [ "$actual" != "$expected" ]; then
+            echo "The supplied keystore ($actual) does not match GAGA_RELEASE_CERT_SHA256 ($expected)." > deliverables/SIGNING-REQUIRED.txt
             exit 0
           fi
