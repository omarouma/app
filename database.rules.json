{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state', 'lastChanged']) && newData.child('state').isString() && newData.child('state').val().matches(/^(online|offline)$/) && newData.child('lastChanged').isNumber() && newData.child('lastChanged').val() <= now"
      }
    },

    "status": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['state']) && newData.child('state').isString()"
      }
    },

    "typing": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['typing', 'updatedAt']) && newData.child('typing').isBoolean() && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() <= now && newData.child('updatedAt').val() > (now - 120000)"
        }
      }
    },

    "signaling": {
      "$callId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['sdp', 'type']) || newData.hasChildren(['candidate'])"
        }
      }
    },

    "receipts": {
      "$chatId": {
        "$uid": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid == $uid",
          ".validate": "newData.hasChildren(['state']) && newData.child('state').val().matches(/^(delivered|read)$/)"
        }
      }
    }
  }
}
