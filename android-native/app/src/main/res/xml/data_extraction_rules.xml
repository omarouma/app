<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ data extraction rules (PDF §10). Neither cloud backup nor
  device-to-device transfer may move the encrypted session or the message
  database.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gaga_secure_session.xml" />
        <exclude domain="database" path="gaga.db" />
        <exclude domain="file" path="media_cache" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gaga_secure_session.xml" />
        <exclude domain="database" path="gaga.db" />
        <exclude domain="file" path="media_cache" />
    </device-transfer>
</data-extraction-rules>
