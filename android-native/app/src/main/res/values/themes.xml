<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base theme. Compose owns the real theming; this only styles the window
         before the first frame and the splash screen (PDF §3). -->
    <style name="Theme.GaGaChat" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- Splash screen theme (androidx.core:core-splashscreen). -->
    <style name="Theme.GaGaChat.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/gaga_violet</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="postSplashScreenTheme">@style/Theme.GaGaChat</item>
    </style>
</resources>
