# Install coturn on a dedicated Alibaba ECS instance with a public IP.
# Copy to /etc/turnserver.conf and replace values through root-only automation.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=SET_FROM_SECRET_MANAGER
realm=turn.gagachat.app
server-name=turn.gagachat.app
external-ip=SET_PUBLIC_IP
min-port=49160
max-port=49260
no-cli
no-loopback-peers
no-multicast-peers
stale-nonce=600
cert=/etc/letsencrypt/live/turn.gagachat.app/fullchain.pem
pkey=/etc/letsencrypt/live/turn.gagachat.app/privkey.pem
log-file=syslog
simple-log
