NODE_ENV=production
PORT=3000
BASE_PATH=/api
PUBLIC_BASE=https://api.gagachat.app
# SQLite is migration input only; production data belongs in Alibaba RDS MySQL.
SQLITE_SOURCE_PATH=/var/lib/gagachat/gagachat.db
RDS_HOST=rm-example.mysql.rds.aliyuncs.com
RDS_PORT=3306
RDS_DATABASE=gagachat
RDS_USER=gagachat_api
RDS_PASSWORD=set-in-alibaba-secret-manager
RDS_SSL=true
REDIS_URL=rediss://:password@redis.example.redis.rds.aliyuncs.com:6379/0
OSS_REGION=oss-ap-southeast-3
OSS_BUCKET=gagachat-production-media
OSS_ACCESS_KEY_ID=set-in-alibaba-secret-manager
OSS_ACCESS_KEY_SECRET=set-in-alibaba-secret-manager
OSS_ENDPOINT=https://oss-ap-southeast-3.aliyuncs.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=gagachat-api
JWT_AUDIENCE=gagachat-android
JWT_TTL=900
REFRESH_TTL=2592000
TRUST_PROXY_HOPS=1
TURN_HOST=turn.gagachat.app
TURN_PORT=3478
TURNS_PORT=5349
TURN_SECRET=replace-with-at-least-32-random-characters
FIREBASE_PROJECT_ID=oumagachat
# FIREBASE_SERVICE_ACCOUNT_JSON must be the ENTIRE service-account private-key
# JSON from Firebase console -> Project oumagachat -> Project settings ->
# Service accounts -> "Generate new private key", compacted onto ONE line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"oumagachat",...}
# firebase-push.js validates project_id == FIREBASE_PROJECT_ID at startup.
FIREBASE_SERVICE_ACCOUNT_JSON=set-as-runtime-secret-not-source-file

# These prototype adapters are forced off in production regardless of value.
ENABLE_SELF_REGISTRATION=true
ENABLE_DEMO_WALLET=false
ENABLE_LOCAL_UPLOADS=false
ALLOW_WS_QUERY_TOKEN=false
