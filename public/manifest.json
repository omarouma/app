{
    "id": "/",
    "name": "GaGa Chat",
    "short_name": "GaGaChat",
    "version": "1.0.1",
    "author": "OMAR FARUK (OumaGa)",
    "creator": "OMAR FARUK",
    "description": "A global free messaging app. Voice & video calls, instant messaging, and Gaga Coins. একটি বিশ্বব্যাপী ফ্রি মেসেজিং অ্যাপ।",
    "start_url": "/",
    "display": "standalone",
    "display_override": [
        "window-controls-overlay",
        "standalone",
        "minimal-ui"
    ],
    "background_color": "#ffffff",
    "theme_color": "#00C300",
    "orientation": "any",
    "scope": "/",
    "categories": [
        "social",
        "communication"
    ],
    "lang": "en",
    "dir": "ltr",
    "prefer_related_applications": false,
    "related_applications": [],
    "icons": [
        {
            "src": "/icons/icon-72x72.png",
            "sizes": "72x72",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-96x96.png",
            "sizes": "96x96",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-128x128.png",
            "sizes": "128x128",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-144x144.png",
            "sizes": "144x144",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-152x152.png",
            "sizes": "152x152",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-192x192.png",
            "sizes": "192x192",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-384x384.png",
            "sizes": "384x384",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-512x512.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "any"
        },
        {
            "src": "/icons/icon-maskable.png",
            "sizes": "512x512",
            "type": "image/png",
            "purpose": "maskable"
        },
        {
            "src": "/logo.svg",
            "sizes": "any",
            "type": "image/svg+xml",
            "purpose": "any"
        }
    ],
    "screenshots": [
        {
            "src": "/screenshots/desktop-wide.png",
            "sizes": "1280x720",
            "type": "image/png",
            "form_factor": "wide",
            "label": "GaGa Chat on desktop"
        },
        {
            "src": "/screenshots/mobile-narrow.png",
            "sizes": "720x1280",
            "type": "image/png",
            "form_factor": "narrow",
            "label": "GaGa Chat on mobile"
        }
    ],
    "shortcuts": [
        {
            "name": "Chats",
            "short_name": "Chats",
            "description": "Open your conversations",
            "url": "/chats",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Timeline",
            "short_name": "Timeline",
            "description": "View social feed",
            "url": "/timeline",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Reels",
            "short_name": "Reels",
            "description": "Watch short videos",
            "url": "/reels",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Contacts",
            "short_name": "Contacts",
            "description": "View your friends",
            "url": "/contacts",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Calls",
            "short_name": "Calls",
            "description": "View call history",
            "url": "/calls",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Marketplace",
            "short_name": "Market",
            "description": "Buy and sell items",
            "url": "/marketplace",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        },
        {
            "name": "Events",
            "short_name": "Events",
            "description": "Discover events near you",
            "url": "/events",
            "icons": [
                {
                    "src": "/icons/icon-96x96.png",
                    "sizes": "96x96"
                }
            ]
        }
    ],
    "share_target": {
        "action": "/share",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "title": "title",
            "text": "text",
            "url": "url",
            "files": [
                {
                    "name": "media",
                    "accept": [
                        "image/*",
                        "video/*"
                    ]
                }
            ]
        }
    },
    "file_handlers": [
        {
            "action": "/share",
            "accept": {
                "image/*": [
                    ".jpg",
                    ".jpeg",
                    ".png",
                    ".gif",
                    ".webp"
                ],
                "video/*": [
                    ".mp4",
                    ".webm",
                    ".mov"
                ]
            }
        }
    ]
}
