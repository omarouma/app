{
  "hosting": {
    "site": "oumagachat",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/.well-known/assetlinks.json",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|svg|webp|ico|css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/app-updates/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store, max-age=0"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/downloads/gaga-latest.apk",
        "destination": "https://fcjgbbmfqdkucfpqjxae.supabase.co/storage/v1/object/public/gaga-app-releases/2.8.10/GaGa-2.8.10-release.apk",
        "type": 302
      },
      {
        "source": "/downloads/gaga-latest.aab",
        "destination": "https://fcjgbbmfqdkucfpqjxae.supabase.co/storage/v1/object/public/gaga-app-releases/2.8.10/GaGa-2.8.10-release.aab",
        "type": 302
      },
      {
        "source": "/downloads/SHA256SUMS.txt",
        "destination": "https://fcjgbbmfqdkucfpqjxae.supabase.co/storage/v1/object/public/gaga-app-releases/2.8.10/SHA256SUMS.txt",
        "type": 302
      },
      {
        "source": "/downloads/gaga-latest-consolidated.apk",
        "destination": "https://fcjgbbmfqdkucfpqjxae.supabase.co/storage/v1/object/public/gaga-app-releases/2.8.10/GaGa-2.8.10-release.apk",
        "type": 302
      }
    ],
    "rewrites": [
      {
        "source": "/chat/**",
        "destination": "/open.html"
      },
      {
        "source": "/call/**",
        "destination": "/open.html"
      },
      {
        "source": "/u/**",
        "destination": "/open.html"
      },
      {
        "source": "/profile/**",
        "destination": "/open.html"
      },
      {
        "source": "/app",
        "destination": "/open.html"
      }
    ]
  }
}
