# ============================================
# Supabase Configuration (Primary Backend)
# ============================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================
# Cloudinary Configuration
# ============================================
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
VITE_CLOUDINARY_API_KEY=your_cloudinary_api_key

# ============================================
# YouTube Data API v3
# ============================================
VITE_YOUTUBE_API_KEY=your_youtube_api_key

# ============================================
# Firebase Configuration
# ============================================
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_FIREBASE_VAPID_KEY=your_vapid_key

# ============================================
# Google Analytics 4
# ============================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# WebRTC TURN Server (optional but recommended for production calls)
# Get a free TURN server at https://www.metered.ca/tools/openrelay/
# ============================================
VITE_TURN_SERVER_URL=turn:openrelay.metered.ca:80
VITE_TURN_SERVER_USERNAME=your_turn_username
VITE_TURN_SERVER_CREDENTIAL=your_turn_credential
