# ============================================================
# GaGa Chat — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ─── Supabase (Required for auth + database) ──────────────────
# Client-safe copies (VITE_ prefix). These ship to the browser in
# the frontend bundle, so they must NOT be secrets.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server copies (NO VITE_ prefix). Same values as the VITE_
# versions above. Used by local CLI tooling (supabase-manager.js),
# Edge Function secrets, and Node scripts. NEVER bundle these.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY  —  admin access, bypasses RLS.
#   Never add a VITE_ prefix; set only on servers/CI that need it.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ACCESS_TOKEN  —  Personal access token (sbp_...) so the
#   `supabase` CLI can login non-interactively (CI / headless).
# SUPABASE_ACCESS_TOKEN=

# ─── Firebase (Required for push notifications + storage fallback) ──
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Sentry (Optional - for error reporting and performance monitoring) ──
VITE_SENTRY_DSN=your-sentry-dsn-here
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=your-sentry-auth-token-here

# ─── TURN/STUN Server (Optional — for reliable calls on strict NAT networks) ──
# Without a TURN server, 1:1 calls and voice rooms may fail on:
#   - Office/corporate networks with strict firewalls
#   - Mobile data connections behind carrier-grade NAT
#   - VPN connections
#
# Deploy a TURN server (e.g., Coturn) and set the credentials below.
# All three values must be set for TURN to be enabled.
#
# Example with Coturn:
# VITE_TURN_SERVER_URL=turn:turn.example.com:3478
# VITE_TURN_SERVER_USERNAME=your-username
# VITE_TURN_SERVER_CREDENTIAL=your-credential
VITE_TURN_SERVER_URL=
VITE_TURN_SERVER_USERNAME=
VITE_TURN_SERVER_CREDENTIAL=

# ─── Cloudinary (Optional — for media uploads) ─────────────────
# Set up an unsigned upload preset in Cloudinary Dashboard.
# If not configured, the app falls back to Firebase Storage then IndexedDB.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ─── YouTube Data API (Optional - for embedding YouTube links) ──
VITE_YOUTUBE_API_KEY=your-youtube-api-key-here
# ─── Agora RTC (Audio/Video Calling) ───
# App ID — safe for client (VITE_ prefixed, public in SDK).
# Get from https://console.agora.io/
VITE_AGORA_APP_ID=your-agora-app-id-here

# App ID (SERVER copy for Edge Functions — same value as VITE_AGORA_APP_ID).
# Supabase Edge Functions access this via Deno.env.get('AGORA_APP_ID').
AGORA_APP_ID=your-agora-app-id-here

# App Certificate — SERVER-ONLY. NEVER add a VITE_ prefix.
# Generate short-lived tokens with this on your server and serve them via:
#   VITE_AGORA_TOKEN_SERVER_URL=https://your-endpoint.example.com/token
# The endpoint accepts a root-relative path (same-origin Hosting rewrite) or an
# absolute URL. Request: GET {url}?channel=... with header
# "Authorization: Bearer <supabase-access-token>" → { token, uid, expireAt }
# The server derives the Agora uid from the authenticated user (do not pass uid).
AGORA_APP_CERTIFICATE=your-agora-app-certificate-SERVER-ONLY
VITE_AGORA_TOKEN_SERVER_URL=https://your-project-ref.supabase.co/functions/v1/agora-token

# Optional: customize the token lifetime (default 43200 = 12 hours).
AGORA_TOKEN_TTL_SEC=43200
