# ============================================================
# GaGa Chat — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ─── Supabase (Required for auth + database) ──────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Firebase (Required for push notifications + storage fallback) ──
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── TURN/STUN Server (Optional — for reliable calls on strict NAT networks) ──
# Without a TURN server, 1:1 calls and voice rooms may fail on:
#   - Office/corporate networks with strict firewalls
#   - Mobile data connections behind carrier-grade NAT
#   - VPN connections
#
# Deploy a TURN server (e.g., Coturn) and set the credentials below.
# All three values must be set for TURN to be enabled.
#
# Example with Coturn:
# VITE_TURN_SERVER_URL=turn:turn.example.com:3478
# VITE_TURN_SERVER_USERNAME=your-username
# VITE_TURN_SERVER_CREDENTIAL=your-credential
VITE_TURN_SERVER_URL=
VITE_TURN_SERVER_USERNAME=
VITE_TURN_SERVER_CREDENTIAL=

# ─── Cloudinary (Optional — for media uploads) ─────────────────
# Set up an unsigned upload preset in Cloudinary Dashboard.
# If not configured, the app falls back to Firebase Storage then IndexedDB.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# ─── Google Analytics (Optional) ──────────────────────────────
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
