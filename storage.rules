rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // User avatars and profile images
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024  // 5MB max
                    && request.resource.contentType.matches('image/.*');
    }

    // Post images and media
    match /posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024  // 10MB max
                    && (request.resource.contentType.matches('image/.*') 
                        || request.resource.contentType.matches('video/.*')
                        || request.resource.contentType.matches('audio/.*'));
    }

    // Story media (24h expiry handled by app, not rules)
    match /stories/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024
                    && (request.resource.contentType.matches('image/.*') 
                        || request.resource.contentType.matches('video/.*'));
    }

    // Reel videos
    match /reels/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 50 * 1024 * 1024  // 50MB max for videos
                    && request.resource.contentType.matches('video/.*');
    }

    // Marketplace item images
    match /marketplace/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Event cover images
    match /events/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Group chat avatars
    match /groups/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
    }

    // Message attachments (images, files, voice notes)
    match /messages/{chatId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 25 * 1024 * 1024  // 25MB max
                    && (request.resource.contentType.matches('image/.*') 
                        || request.resource.contentType.matches('video/.*')
                        || request.resource.contentType.matches('audio/.*')
                        || request.resource.contentType.matches('application/pdf')
                        || request.resource.contentType.matches('application/zip'));
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}