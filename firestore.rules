// ═══════════════════════════════════════════════════════════════════════════════
// GaGa Chat — Firestore Security Rules
// ═══════════════════════════════════════════════════════════════════════════════
//
// Deploy with:  firebase deploy --only firestore:rules
//
// Schema (matches the deployed composite indexes):
//   users/{uid}                                  profile + subcollections
//   chats/{chatId}                               participants:[uid], type, updatedAt
//   chats/{chatId}/messages/{messageId}          text / image / video / audio / …
//   chats/{chatId}/messages/{messageId}/reactions/{uid}
//   chats/{chatId}/typing/{uid}
//   calls/{callId}                               initiatorId/recipientId/participants
//   calls/{callId}/signaling/{sigId}             WebRTC offer/answer/ICE
//   call_history/{id}                            callerId/calleeId/participantIds
//   presence/{uid}
//   typing/{typingId}
//   friend_requests/{id}  friendships/{id}  blocked_users/{id}
//   notifications/{id}    user_devices/{id}  reports/{id}  config/{id}
//
// Access model: deny-by-default; a user may only touch a conversation they are a
// participant of, and may only author messages/reactions as themselves. Media
// objects are gated by the matching Storage rules (chat participants only).
// ═══════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────── helpers ───────────────────────────
    function isAuth() {
      return request.auth != null;
    }
    function uid() {
      return request.auth.uid;
    }
    function isSelf(userId) {
      return isAuth() && uid() == userId;
    }
    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }
    function isChatMember(chatId) {
      return isAuth() && uid() in chatData(chatId).participants;
    }
    function callData(callId) {
      return get(/databases/$(database)/documents/calls/$(callId)).data;
    }
    function isCallParty(callId) {
      return isAuth() && (
        uid() == callData(callId).initiatorId ||
        uid() == callData(callId).recipientId ||
        uid() in callData(callId).participants
      );
    }

    // ─────────────────────────── users ───────────────────────────
    match /users/{userId} {
      // Public profile is readable by any signed-in user (contacts, search).
      allow read: if isAuth();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
        && !("role" in request.resource.data.diff(resource.data).affectedKeys())
        && !("admin" in request.resource.data.diff(resource.data).affectedKeys())
        && !("isAdmin" in request.resource.data.diff(resource.data).affectedKeys())
        && !("isModerator" in request.resource.data.diff(resource.data).affectedKeys());
      allow delete: if isSelf(userId);

      match /metadata/{doc=**}         { allow read, write: if isSelf(userId); }
      match /notification_prefs/{doc=**}{ allow read, write: if isSelf(userId); }
      match /wallet/{doc=**}           { allow read: if isSelf(userId); allow write: if false; }
      match /blocked/{blockedUserId}   { allow read, write: if isSelf(userId); }
      match /saved_messages/{messageId}{ allow read, write: if isSelf(userId); }
      match /devices/{deviceId}        { allow read, write: if isSelf(userId); }
    }

    // ─────────────────── chats (1:1 and groups) ───────────────────
    // Both direct and group conversations live in `chats`; `type` distinguishes
    // them ("dm" | "group") and `participants` is the authoritative member list.
    match /chats/{chatId} {
      allow read:   if isAuth() && uid() in resource.data.participants;
      allow create: if isAuth()
        && uid() in request.resource.data.participants
        && request.resource.data.participants.size() >= 1;
      // Firebase is a mirror; participants/type are authoritative in Supabase.
      // A member may refresh only derived list-preview fields, never membership.
      allow update: if isAuth()
        && uid() in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'updatedAt', 'lastMessage', 'lastMessageAt',
          'lastMessageSenderId', 'lastMessageType', 'lastMessagePreview'
        ]);
      allow delete: if false;

      // Messages — only participants; author must be the sender.
      match /messages/{messageId} {
        allow read: if isChatMember(chatId);

        allow create: if isChatMember(chatId)
          && request.resource.data.senderId == uid()
          && request.resource.data.size() < 200;

        allow update: if isChatMember(chatId) && (
          // Author may change only mutable message presentation fields.
          (resource.data.senderId == uid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'text', 'editedAt', 'deletedAt', 'reactions',
              'deliveredTo', 'readBy', 'updatedAt'
            ]))
          // Other participants may only acknowledge delivery/read or react.
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['deliveredTo', 'readBy', 'reactions', 'updatedAt'])
        );

        allow delete: if isChatMember(chatId) && resource.data.senderId == uid();

        match /reactions/{reactionId} {
          allow read: if isChatMember(chatId);
          allow create: if isChatMember(chatId)
            && request.resource.data.userId == uid();
          allow update: if isChatMember(chatId)
            && resource.data.userId == uid()
            && request.resource.data.userId == resource.data.userId;
          allow delete: if isChatMember(chatId)
            && resource.data.userId == uid();
        }
      }

      // Per-chat typing indicators (chats/{chatId}/typing/{uid}).
      match /typing/{userId} {
        allow read: if isChatMember(chatId);
        allow write: if isChatMember(chatId) && userId == uid();
      }

      // Per-chat call records are backend mirrors; clients can only read them.
      match /calls/{callId} {
        allow read: if isChatMember(chatId);
        allow create, update, delete: if false;
      }
    }

    // ─────────────────────────── presence ───────────────────────────
    match /presence/{userId} {
      allow read: if isAuth();
      allow write, delete: if isSelf(userId);
    }

    // ─────────────────────────── typing (flat) ───────────────────────────
    match /typing/{typingId} {
      allow read: if isAuth() && isChatMember(resource.data.chatId);
      allow create: if isAuth()
        && request.resource.data.userId == uid()
        && isChatMember(request.resource.data.chatId);
      allow update: if isAuth()
        && resource.data.userId == uid()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.chatId == resource.data.chatId
        && isChatMember(resource.data.chatId);
      allow delete: if isAuth()
        && resource.data.userId == uid()
        && isChatMember(resource.data.chatId);
    }

    // ─────────────────────────── calls ───────────────────────────
    match /calls/{callId} {
      // LiveKit/Supabase is authoritative for call lifecycle. Firebase call
      // records are read-only to participants; clients cannot forge/update them.
      allow read: if isCallParty(callId);
      allow create, update, delete: if false;

      // Legacy WebRTC signaling is disabled; LiveKit/Supabase owns signaling.
      match /signaling/{sigId} {
        allow read: if isCallParty(callId);
        allow create, update, delete: if false;
      }
    }

    // ─────────────────────────── call history ───────────────────────────
    match /call_history/{id} {
      allow read: if isAuth() && (
        uid() == resource.data.callerId ||
        uid() == resource.data.calleeId ||
        uid() in resource.data.participantIds
      );
      allow create, update, delete: if false;
    }

    // ─────────────────────────── friend requests ───────────────────────────
    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        uid() == resource.data.fromUserId || uid() == resource.data.toUserId
      );
      allow create: if isAuth() && request.resource.data.fromUserId == uid();
      allow update: if isAuth()
        && uid() == resource.data.toUserId
        && request.resource.data.fromUserId == resource.data.fromUserId
        && request.resource.data.toUserId == resource.data.toUserId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAuth() && (
        uid() == resource.data.fromUserId || uid() == resource.data.toUserId
      );
    }

    // ─────────────────────────── friendships ───────────────────────────
    match /friendships/{id} {
      allow read: if isAuth() && (
        uid() == resource.data.userId ||
        uid() == resource.data.friendId ||
        uid() in resource.data.members
      );
      allow create: if false;
      allow update: if false;   // maintained by backend on accept
      allow delete: if isAuth() && (
        uid() == resource.data.userId ||
        uid() == resource.data.friendId ||
        uid() in resource.data.members
      );
    }

    // ─────────────────────────── blocked users ───────────────────────────
    match /blocked_users/{id} {
      allow read: if isAuth() && (
        uid() == resource.data.blockerId || uid() == resource.data.userId
      );
      allow create: if isAuth()
        && uid() == request.resource.data.blockerId;
      allow delete: if isAuth()
        && uid() == resource.data.blockerId;
      allow update: if false;
    }

    // ─────────────────────────── notifications ───────────────────────────
    match /notifications/{id} {
      allow read: if isAuth() && uid() == resource.data.userId;
      // Notifications are created by trusted backend code only. A recipient may
      // only change read-state metadata; ownership/content stays immutable.
      allow create: if false;
      allow update: if isAuth()
        && uid() == resource.data.userId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if isAuth() && uid() == resource.data.userId;
    }

    // ─────────────────────────── user devices (FCM) ───────────────────────────
    match /user_devices/{id} {
      allow read: if isAuth() && uid() == resource.data.userId;
      allow create: if isAuth() && uid() == request.resource.data.userId;
      allow update: if isAuth()
        && uid() == resource.data.userId
        && request.resource.data.userId == resource.data.userId;
      allow delete: if isAuth() && uid() == resource.data.userId;
    }

    // ─────────────────────────── reports ───────────────────────────
    match /reports/{id} {
      allow read: if isAuth() && uid() == resource.data.reporterId;
      allow create: if isAuth() && request.resource.data.reporterId == uid();
      allow update, delete: if false;   // moderation backend only
    }

    // ─────────────────────────── config ───────────────────────────
    match /config/{id} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─────────────────────────── deny by default ───────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
