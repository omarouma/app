// ═══════════════════════════════════════════════════════════════════════════════
// GaGa Chat — Firestore Security Rules (Firebase-first, hardened)
// ═══════════════════════════════════════════════════════════════════════════════
//
// Deploy with:  firebase deploy --only firestore:rules
//
// IDENTITY MODEL (see docs/FIREBASE_MIGRATION_PLAN.md §2)
//   The canonical user id in every rule is the custom claim `gaga_user_id`,
//   injected into the Firebase ID token by the trusted `firebase-identity`
//   backend after it has *proven* ownership of the account. It is NEVER derived
//   from an email string. Until an account is mapped, `myId()` is empty and the
//   account cannot touch any chat data. Unverified emails are also blocked.
//
// SCHEMA
//   users/{uid}                                   public profile (uid == gaga_user_id)
//     private/{doc}                               email, phone, settings, fcm tokens…
//     devices/{deviceId}  blocked/{uid}  saved_messages/{id}
//   chats/{chatId}                                type, title, participants[], memberCount
//     members/{uid}                               role, notificationPref, archived, pinned, read pos
//     messages/{messageId}                        senderId, type, text, attachments…
//       reactions/{uid}                           { emoji, at }   doc id == reactor
//       receipts/{uid}                            { state, at }   doc id == recipient
//       hidden/{uid}                              per-user "delete for me"
//     typing/{uid}
//     calls/{callId}
//   presence/{uid}
//   typing/{chatId}_{uid}
//   calls/{callId}  calls/{callId}/signaling/{sigId}
//   call_history/{id}
//   requests/{id}   friend_requests/{id}  friendships/{id}  blocked_users/{id}
//   notifications/{id}  user_devices/{id}  reports/{id}  config/{id}
//
// ACCESS MODEL (the P0 security contract)
//   1. Participant-only reads on every chat subcollection.
//   2. No self-granted membership: a user can never add themselves to a chat,
//      nor raise their own role. Membership/role changes require an admin/owner.
//   3. Author-only message edits: only senderId == uid may change content.
//   4. Receipt ownership: receipts/{uid} may only be written by that uid.
//   5. Reaction ownership: reactions/{uid} may only be written by that uid.
//   6. Profile field separation: users/{uid}/private/** is owner-only.
//   7. Deny by default.
// ═══════════════════════════════════════════════════════════════════════════════

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────── helpers ───────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    // Canonical GaGa user id from the trusted custom claim. Empty until mapped.
    function myId() {
      return request.auth.token.get('gaga_user_id', '');
    }

    // Firebase sets `email_verified` on every ID token.
    function emailVerified() {
      return request.auth.token.get('email_verified', false) == true;
    }

    // A mapped + verified account. Every protected feature requires this.
    function ready() {
      return signedIn() && emailVerified() && myId() != '';
    }

    function isSelf(userId) {
      return ready() && userId == myId();
    }

    function chatData(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data;
    }

    // Membership authority = the denormalised `participants` array on the chat
    // document (query-friendly, and only admins may mutate it — see below).
    function isMember(chatId) {
      return ready() && myId() in chatData(chatId).participants;
    }

    function memberDoc(chatId, userId) {
      return get(/databases/$(database)/documents/chats/$(chatId)/members/$(userId)).data;
    }

    // Role authority = the members subcollection (single-doc reads only).
    function isAdmin(chatId) {
      return ready() && memberDoc(chatId, myId()).role in ['owner', 'admin'];
    }
    function isOwner(chatId) {
      return ready() && memberDoc(chatId, myId()).role == 'owner';
    }

    function callData(callId) {
      return get(/databases/$(database)/documents/calls/$(callId)).data;
    }
    function isCallParty(callId) {
      return ready() && (
        myId() == callData(callId).initiatorId ||
        myId() == callData(callId).recipientId ||
        myId() in callData(callId).participants
      );
    }

    // ─────────────────────────────── users ───────────────────────────────
    // Public profile fields are readable by any mapped+verified account
    // (contacts, search). Private fields live in the `private` subcollection.
    match /users/{userId} {
      allow get: if ready();
      allow list: if ready();
      allow create: if isSelf(userId)
        && request.resource.data.gagaId is string
        && request.resource.data.gagaId.size() >= 3;
      // Only non-privileged, non-identity fields may change. `gagaId`,
      // `emailVerified`, roles and timestamps are immutable here.
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['displayName', 'photoUrl', 'about', 'updatedAt']);
      allow delete: if false;   // account deletion goes through the backend

      // Private profile: owner only, never exposed to other users.
      match /private/{doc=**} {
        allow read, write: if isSelf(userId);
      }
      match /metadata/{doc=**}          { allow read, write: if isSelf(userId); }
      match /notification_prefs/{doc=**} { allow read, write: if isSelf(userId); }
      match /wallet/{doc=**}            { allow read: if isSelf(userId); allow write: if false; }
      match /blocked/{blockedUserId}    { allow read, write: if isSelf(userId); }
      match /saved_messages/{messageId} { allow read, write: if isSelf(userId); }
      match /devices/{deviceId}         { allow read, write: if isSelf(userId); }
    }

    // ─────────────────────────── chats (dm | group) ───────────────────────────
    match /chats/{chatId} {
      // Read: only a participant. List queries MUST constrain with
      // `whereArrayContains("participants", <myId>)` so this is provable.
      allow read: if ready() && myId() in resource.data.participants;

      // Create: the creator must be in the participant list and must be the
      // author of the conversation. The initial participant list is validated
      // here; later mutations require an admin (see update).
      allow create: if ready()
        && request.resource.data.createdBy == myId()
        && myId() in request.resource.data.participants
        && request.resource.data.participants.size() >= 1
        && request.resource.data.participants.size() <= 256
        && request.resource.data.type in ['dm', 'group', 'saved'];

      // Update: ordinary members may only touch activity/preview fields. Only an
      // admin/owner may change membership, title, photo or type. This is what
      // makes "no self-granted membership" true.
      allow update: if ready() && isMember(chatId) && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessageAt', 'lastMessagePreview', 'lastMessageSenderId', 'updatedAt'])
        || (isAdmin(chatId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['title', 'photoUrl', 'participants', 'memberCount', 'type', 'updatedAt'])
            && (request.resource.data.type != 'dm' || isOwner(chatId)))
      );

      // Deletion is a privileged action performed by the backend/owner flow.
      allow delete: if false;

      // ── members (role + per-member metadata) ──
      match /members/{memberId} {
        allow read: if isMember(chatId);

        // Self-join is allowed only if the creator already listed you as a
        // participant; you may only take the 'owner' role if you created it.
        // Admins may add others (never as owner unless they are the owner).
        allow create: if ready() && (
          (memberId == myId()
            && myId() in chatData(chatId).participants
            && request.resource.data.role in ['member', 'owner']
            && (request.resource.data.role == 'member'
                || chatData(chatId).createdBy == myId()))
          || (isAdmin(chatId)
              && memberId != myId()
              && request.resource.data.role in ['member', 'admin']
              && (request.resource.data.role != 'admin' || isOwner(chatId)))
        );

        // Self-service: only benign per-member fields. Role changes are admin
        // only, cannot target yourself, and cannot mint an owner unless you are
        // one. No self-escalation is possible.
        allow update: if ready() && (
          (memberId == myId()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['notificationPref', 'archived', 'pinned',
                           'lastReadMessageId', 'lastReadAt', 'updatedAt']))
          || (isAdmin(chatId)
              && memberId != myId()
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['role', 'updatedAt'])
              && (request.resource.data.role != 'owner' || isOwner(chatId)))
        );

        // Leave the chat yourself, or be removed by an admin (owners are not
        // removable by other admins).
        allow delete: if ready() && (
          memberId == myId()
          || (isAdmin(chatId) && memberId != myId()
              && memberDoc(chatId, memberId).role != 'owner')
        );
      }

      // ── messages ──
      match /messages/{messageId} {
        allow read: if isMember(chatId);

        allow create: if ready() && isMember(chatId)
          && request.resource.data.senderId == myId()
          && request.resource.data.size() < 100
          && request.resource.data.type in
               ['text', 'image', 'video', 'audio', 'voice', 'file', 'document', 'sticker', 'gif', 'system'];

        // Author-only edits. Receipts/reactions/hidden are separate docs, so no
        // other member can ever mutate a message they did not write.
        allow update: if ready() && isMember(chatId)
          && resource.data.senderId == myId()
          && request.resource.data.senderId == resource.data.senderId;

        allow delete: if ready() && isMember(chatId)
          && resource.data.senderId == myId();

        // Reaction ownership — doc id == reactor; forgery is impossible.
        match /reactions/{reactorId} {
          allow read: if isMember(chatId);
          allow create, update: if ready() && isMember(chatId)
            && reactorId == myId()
            && request.resource.data.emoji is string
            && request.resource.data.emoji.size() <= 8;
          allow delete: if ready() && isMember(chatId) && reactorId == myId();
        }

        // Receipt ownership — doc id == recipient; you can only write your own.
        match /receipts/{recipientId} {
          allow read: if isMember(chatId);
          allow create, update: if ready() && isMember(chatId)
            && recipientId == myId()
            && request.resource.data.state in ['delivered', 'read'];
          allow delete: if false;
        }

        // "Delete for me" — per-user, keyed by the acting user.
        match /hidden/{userId} {
          allow read: if ready() && isMember(chatId) && userId == myId();
          allow create, delete: if ready() && isMember(chatId) && userId == myId();
        }
      }

      // ── typing ──
      match /typing/{userId} {
        allow read: if isMember(chatId);
        allow write: if ready() && isMember(chatId) && userId == myId();
      }

      // ── per-chat call records ──
      match /calls/{callId} {
        allow read: if isMember(chatId);
        allow create, update: if ready() && isMember(chatId);
      }
    }

    // ─────────────────────────────── presence ───────────────────────────────
    match /presence/{userId} {
      allow read: if ready();
      allow write, delete: if isSelf(userId);
    }

    // ─────────────────────────── typing (flat, RTDB-style) ───────────────────────────
    match /typing/{typingId} {
      allow read: if ready();
      allow create, update: if ready() && request.resource.data.userId == myId();
      allow delete: if ready() && resource.data.userId == myId();
    }

    // ─────────────────────────────── calls ───────────────────────────────
    match /calls/{callId} {
      allow read:   if isCallParty(callId);
      allow create: if ready() && (
        myId() == request.resource.data.initiatorId ||
        myId() in request.resource.data.participants
      );
      allow update: if isCallParty(callId);
      allow delete: if isCallParty(callId);

      match /signaling/{sigId} {
        allow read: if ready() && (
          myId() == resource.data.fromUserId || myId() == resource.data.toUserId
        );
        allow create: if ready() && request.resource.data.fromUserId == myId();
        allow delete: if ready() && (
          myId() == resource.data.fromUserId || myId() == resource.data.toUserId
        );
      }
    }

    // ─────────────────────────────── call history ───────────────────────────────
    match /call_history/{id} {
      allow read: if ready() && (
        myId() == resource.data.callerId ||
        myId() == resource.data.calleeId ||
        myId() in resource.data.participantIds
      );
      allow create: if ready() && (
        myId() == request.resource.data.callerId ||
        myId() in request.resource.data.participantIds
      );
      allow update, delete: if ready() && (
        myId() == resource.data.callerId ||
        myId() == resource.data.calleeId ||
        myId() in resource.data.participantIds
      );
    }

    // ─────────────────────────── requests (unified) ───────────────────────────
    match /requests/{requestId} {
      allow read: if ready() && (
        myId() == resource.data.fromUserId || myId() == resource.data.toUserId
      );
      allow create: if ready() && request.resource.data.fromUserId == myId();
      allow update: if ready() && (
        myId() == resource.data.fromUserId || myId() == resource.data.toUserId
      );
      allow delete: if ready() && (
        myId() == resource.data.fromUserId || myId() == resource.data.toUserId
      );
    }

    // ─────────────────────── legacy friend requests / friendships ───────────────────────
    match /friend_requests/{requestId} {
      allow read: if ready() && (
        myId() == resource.data.fromUserId || myId() == resource.data.toUserId
      );
      allow create: if ready() && request.resource.data.fromUserId == myId();
      allow update, delete: if ready() && (
        myId() == resource.data.fromUserId || myId() == resource.data.toUserId
      );
    }

    match /friendships/{id} {
      allow read: if ready() && (
        myId() == resource.data.userId ||
        myId() == resource.data.friendId ||
        myId() in resource.data.members
      );
      allow create: if ready() && (
        myId() == request.resource.data.userId || myId() in request.resource.data.members
      );
      allow update: if false;   // maintained by the backend on accept
      allow delete: if ready() && (
        myId() == resource.data.userId ||
        myId() == resource.data.friendId ||
        myId() in resource.data.members
      );
    }

    // ─────────────────────────────── blocked users ───────────────────────────────
    match /blocked_users/{id} {
      allow read: if ready() && (
        myId() == resource.data.blockerId || myId() == resource.data.userId
      );
      allow create: if ready() && request.resource.data.blockerId == myId();
      allow delete: if ready() && resource.data.blockerId == myId();
      allow update: if false;
    }

    // ─────────────────────────────── notifications ───────────────────────────────
    match /notifications/{id} {
      allow read: if ready() && myId() == resource.data.userId;
      allow create: if false;   // backend only
      allow update: if ready() && myId() == resource.data.userId;
      allow delete: if ready() && myId() == resource.data.userId;
    }

    // ─────────────────────────────── user devices (FCM) ───────────────────────────────
    match /user_devices/{id} {
      allow read: if ready() && myId() == resource.data.userId;
      allow create: if ready() && myId() == request.resource.data.userId;
      allow update, delete: if ready() && myId() == resource.data.userId;
    }

    // ─────────────────────────────── reports ───────────────────────────────
    match /reports/{id} {
      allow read: if ready() && myId() == resource.data.reporterId;
      allow create: if ready() && request.resource.data.reporterId == myId();
      allow update, delete: if false;   // moderation backend only
    }

    // ─────────────────────────────── config ───────────────────────────────
    match /config/{id} {
      allow read: if ready();
      allow write: if false;
    }

    // ─────────────────────────────── deny by default ───────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
