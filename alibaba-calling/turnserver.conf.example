# Replace these placeholders before installing. Do not deploy this example unchanged.
listening-port=3478
tls-listening-port=5349
listening-ip=PRIVATE_ECS_IP
relay-ip=PRIVATE_ECS_IP
external-ip=PUBLIC_ECS_IP/PRIVATE_ECS_IP
min-port=49160
max-port=49259
fingerprint
use-auth-secret
static-auth-secret=SAME_TURN_SHARED_SECRET_AS_CALLING_SERVER
realm=turn.gagachat.app
server-name=turn.gagachat.app
cert=/etc/letsencrypt/live/turn.gagachat.app/fullchain.pem
pkey=/etc/letsencrypt/live/turn.gagachat.app/privkey.pem
no-cli
no-multicast-peers
no-tlsv1
no-tlsv1_1
user-quota=4
total-quota=200
# Block relay traffic into private/metadata networks.
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
