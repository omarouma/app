{
  "name": "gaga-chat",
  "version": "1.0.0",
  "description": "GaGa Chat - Real-time messaging and calling platform with complete notification and background support",
  "author": "OMAR FARUK (OumaGa)",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:functions": "cd functions && npm run build",
    "postbuild": "node scripts/postbuild-sw-stamp.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy": "npm run build && firebase deploy --only hosting",
    "deploy:full": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && npm run build && firebase deploy --only hosting",
    "deploy:rules": "echo 'No Firestore/Storage rules to deploy \u2014 app data is managed via Supabase RLS.'",
    "deploy:hosting": "npm run build && firebase deploy --only hosting",
    "deploy:ci": "npm ci && npm run build && firebase deploy --only hosting --non-interactive",
    "preview:prod": "vite preview --port 4173",
    "preview": "vite preview",
    "native:sync": "npx cap sync android && node scripts/strip-native-web-assets.mjs",
    "native:build": "npm run build && npm run native:sync"
  },
  "dependencies": {
    "@capacitor/android": "6.2.2",
    "@capacitor/app": "6.0.2",
    "@capacitor/core": "6.2.2",
    "@capacitor/keyboard": "6.0.3",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/push-notifications": "6.0.4",
    "@capacitor/splash-screen": "6.0.3",
    "@capacitor/status-bar": "6.0.2",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-switch": "^1.3.1",
    "@supabase/supabase-js": "^2.110.2",
    "@types/qrcode": "^1.5.6",
    "@zegocloud/zego-uikit-prebuilt": "^2.18.1",
    "clsx": "^2.1.1",
    "firebase": "^12.15.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.562.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.2",
    "react-router-dom": "^7.18.2",
    "react-virtuoso": "^4.18.11",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1",
    "zego-zim-web": "^3.2.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "6.2.2",
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "firebase-tools": "^15.25.1",
    "globals": "^16.5.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^3.2.4"
  }
}
